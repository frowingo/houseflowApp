<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Social sign-in buttons this build shows: any of google, facebook, snapchat (Apple is never
        offered on Android). A listed provider whose ID below is still a YOUR_… placeholder keeps its
        button, but tapping it explains that the method is not set up yet.
    -->
    <string-array name="houseflow_social_providers" translatable="false">
        <item>google</item>
        <item>facebook</item>
        <item>snapchat</item>
    </string-array>

    <!-- Google: the *web* client ID (not the Android one); the ID token's audience. -->
    <string name="google_web_client_id" translatable="false">323555794723-auuvmu7ukiimkft24u57vjjjr4k8617t.apps.googleusercontent.com</string>

    <!-- Facebook: App ID, client token, and "fb" + App ID for the Custom Tab redirect. -->
    <string name="facebook_app_id" translatable="false">YOUR_FACEBOOK_APP_ID</string>
    <string name="facebook_client_token" translatable="false">YOUR_FACEBOOK_CLIENT_TOKEN</string>
    <string name="fb_login_protocol_scheme" translatable="false">fbYOUR_FACEBOOK_APP_ID</string>

    <!-- Snapchat Login Kit. -->
    <string name="snap_client_id" translatable="false">YOUR_SNAPCHAT_CLIENT_ID</string>
    <string name="snap_redirect_url" translatable="false">houseflow://snap-kit/oauth2</string>
    <string-array name="snap_connect_scopes" translatable="false">
        <item>https://auth.snapchat.com/oauth2/api/user.display_name</item>
        <item>https://auth.snapchat.com/oauth2/api/user.external_id</item>
    </string-array>
</resources>
