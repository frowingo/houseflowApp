<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Until the app first applies the user's launch style, the default theme (Faus Light). -->
    <style name="Theme.FausCrew" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_light</item>
        <!-- Plain theme color, no icon: the animated FausSplash draws the mark from scratch. -->
        <item name="android:windowSplashScreenBackground">@color/launch_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>

    <!-- Applied with SplashScreen.setSplashScreenTheme; persisted by name, so keep names stable. -->
    <style name="Theme.FausCrew.Launch.Light" parent="Theme.FausCrew">
        <item name="android:windowBackground">@color/launch_light</item>
        <item name="android:windowSplashScreenBackground">@color/launch_light</item>
    </style>
    <style name="Theme.FausCrew.Launch.Dark" parent="Theme.FausCrew">
        <item name="android:windowBackground">@color/launch_dark</item>
        <item name="android:windowSplashScreenBackground">@color/launch_dark</item>
    </style>
    <style name="Theme.FausCrew.Launch.Bloom" parent="Theme.FausCrew">
        <item name="android:windowBackground">@color/launch_bloom</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bloom</item>
    </style>
    <style name="Theme.FausCrew.Launch.Web" parent="Theme.FausCrew">
        <item name="android:windowBackground">@color/launch_web</item>
        <item name="android:windowSplashScreenBackground">@color/launch_web</item>
    </style>
</resources>
